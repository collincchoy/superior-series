---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const games = [
  {
    href: `${base}arni/`,
    icon: `${base}arni/icons/icon.svg`,
    title: "Arni vs. Rex",
    blurb: "Help Arni the dinosaur stomp, whip and roar through 10 levels to beat Rex the Banana.",
  },
  {
    href: `${base}catan/`,
    icon: `${base}catan-icons/icon-192.svg`,
    title: "Catan: Cities & Knights",
    blurb: "The board game in your browser. Play with friends over a room code, or against bots.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <Navigation />

    <h1>Astro</h1>

    <section class="games">
      <h2>Games</h2>
      <ul>
        {
          games.map((g) => (
            <li>
              <a href={g.href}>
                <img src={g.icon} alt="" width="72" height="72" />
                <span>
                  <strong>{g.title}</strong>
                  <small>{g.blurb}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Footer />
  </body>
</html>

<style>
  .games ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    max-width: 560px;
  }

  .games a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px;
    border: 2px solid #ddd;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
  }

  .games a:hover,
  .games a:focus-visible {
    border-color: #4c1d95;
  }

  .games img {
    border-radius: 16px;
    flex: none;
  }

  .games span {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
