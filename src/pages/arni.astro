---
import ArniApp from "../components/arni/ArniApp.svelte";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#3a2f66" />
    <meta name="description" content="Help Arni the dinosaur beat Rex the Banana!" />
    <!-- Installable as its own app (separate from Catan): see public/arni/. -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}arni/manifest.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}arni/icons/icon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}arni/icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Arni vs. Rex" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>Arni vs. Rex</title>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        height: 100%;
        overflow: hidden;
        background: #1b2a4a;
        overscroll-behavior: none;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
      }

      #app {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
          env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
      }
    </style>
  </head>
  <body>
    <div id="app">
      <ArniApp client:only="svelte" />
    </div>
    <script>
      if ("serviceWorker" in navigator) {
        const base = import.meta.env.BASE_URL;
        if (import.meta.env.DEV) {
          // Dev assets aren't hashed: drop Arni's worker so nothing is served stale.
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.filter((r) => r.scope.endsWith(`${base}arni/`)).forEach((r) => r.unregister());
          });
        } else {
          const firstVisit = !navigator.serviceWorker.controller;
          navigator.serviceWorker
            .register(`${base}arni/sw.js`, { scope: `${base}arni/`, updateViaCache: "none" })
            .catch(() => {});
          // First visit: the game loaded before the worker could see it. Once the
          // sprites are in (a few seconds), hand the worker the list so the game
          // also works offline from the next launch.
          if (firstVisit) {
            setTimeout(() => {
              navigator.serviceWorker.ready.then((reg) =>
                reg.active?.postMessage({
                  type: "cache-loaded",
                  urls: performance.getEntriesByType("resource").map((e) => e.name),
                }),
              );
            }, 6000);
          }
        }
      }
    </script>
  </body>
</html>
